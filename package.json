{
  "name": "venturedex",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run screenshots:validate && npm run investors:validate && npm run curation:validate && npm run weekly:og && astro build",
    "curation:validate": "python3 scripts/curation.py validate",
    "curation:plan": "python3 scripts/curation.py plan",
    "curation:lookup": "python3 scripts/curation.py lookup",
    "investors:validate": "tsx scripts/investor-research.ts validate",
    "investors:audit-sources": "node scripts/audit-investor-sources.mjs",
    "investors:plan": "tsx scripts/investor-research.ts plan",
    "screenshots:validate": "node scripts/screenshot-quality.mjs validate",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "test:newsletter": "tsx --test tests/*.test.ts",
    "db:migrate": "bash scripts/migrate-newsletter.sh --local && wrangler d1 execute venturedex-db --local --file=d1/schema.sql && python3 scripts/migrate-funding.py --local",
    "seo:gsc": "bash scripts/submit-gsc-direct.sh",
    "seo:gsc:plan": "python3 scripts/gsc-codex.py plan",
    "seo:gsc:daily:dry": "python3 scripts/gsc-codex.py plan --latest-daily",
    "seo:gsc:daily:submit": "bash scripts/submit-gsc-direct.sh --latest-daily",
    "seo:gsc:weekly:dry": "python3 scripts/gsc-codex.py plan --latest-weekly",
    "seo:gsc:weekly:submit": "bash scripts/submit-gsc-direct.sh --latest-weekly",
    "seo:gsc:latest:dry": "python3 scripts/gsc-codex.py plan --latest-daily --latest-weekly",
    "seo:gsc:latest:submit": "bash scripts/submit-gsc-direct.sh --latest-daily --latest-weekly",
    "seo:gsc:diagnose": "tsx scripts/promotion/gsc-diagnostics.ts --write",
    "seo:indexnow:latest:dry": "tsx scripts/promotion/indexnow.ts --dry-run --latest-daily --latest-weekly",
    "seo:indexnow:latest": "tsx scripts/promotion/indexnow.ts --latest-daily --latest-weekly",
    "seo:indexnow:latest:submit": "tsx scripts/promotion/indexnow.ts --latest-daily --latest-weekly",
    "seo:indexnow:topics": "tsx scripts/promotion/indexnow.ts --topics",
    "seo:indexnow:structure": "tsx scripts/promotion/indexnow.ts --hubs --collections --topics --ai-surfaces",
    "seo:indexnow:all-content": "tsx scripts/promotion/indexnow.ts --all-startups --all-weekly --all-launches --topics --hubs --collections --ai-surfaces --max-urls 2500",
    "seo:indexnow:launches:dry": "tsx scripts/promotion/indexnow.ts --dry-run --all-launches --ai-surfaces --url https://venturedex.co/launches --max-urls 10000",
    "seo:indexnow:launches": "tsx scripts/promotion/indexnow.ts --all-launches --ai-surfaces --url https://venturedex.co/launches --max-urls 10000",
    "geo:indexnow": "tsx scripts/promotion/indexnow.ts --ai-surfaces",
    "weekly:og": "tsx scripts/weekly-og.ts --all --write",
    "whatships:sync": "tsx scripts/sync-whatships.ts",
    "whatships:check": "tsx scripts/sync-whatships.ts --check",
    "launches:covers": "tsx scripts/launch-covers.ts",
    "launches:covers:check": "tsx scripts/launch-covers.ts --check",
    "promotion:pack": "tsx scripts/promotion/build-pack.ts --latest-daily --latest-weekly --write",
    "growth:report": "tsx scripts/promotion/growth-report.ts --write"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "astro": "7.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260726.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "better-sqlite3": "^12.11.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
