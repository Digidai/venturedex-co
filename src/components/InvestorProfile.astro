---
import { INVESTOR_FACT_LABELS, type InvestorProfile } from "../lib/investor-profiles";
interface Props { profile: InvestorProfile }
const { profile } = Astro.props;
const refs = (ids: string[]) => ids.map((id) => ({
  id,
  number: profile.sources.findIndex((source) => source.id === id) + 1,
}));
---

<section class="firm-profile" aria-labelledby="firm-profile-title">
  <div class="profile-heading">
    <h2 id="firm-profile-title">Firm profile</h2>
    <p class="review-date">Reviewed <time datetime={profile.reviewed_at}>{profile.reviewed_at}</time></p>
  </div>
  <p class="profile-summary">
    {profile.summary.value}
    <span class="citations">
      {refs(profile.summary.source_ids).map((ref) => <a href={`#investor-source-${ref.id}`} aria-label={`Source ${ref.number}`}>[{ref.number}]</a>)}
    </span>
  </p>
  <dl class="profile-facts">
    {profile.facts.map((fact) => (
      <div class:list={["profile-fact", { "wide": ["approach", "support", "entity_scope"].includes(fact.key) }]}>
        <dt>{INVESTOR_FACT_LABELS[fact.key]}</dt>
        <dd>
          {Array.isArray(fact.value) ? fact.value.join(" · ") : fact.value}
          <span class="citations">
            {refs(fact.source_ids).map((ref) => <a href={`#investor-source-${ref.id}`} aria-label={`Source ${ref.number} for ${INVESTOR_FACT_LABELS[fact.key]}`}>[{ref.number}]</a>)}
          </span>
        </dd>
      </div>
    ))}
  </dl>
  <div class="profile-sources">
    <h3>Sources & official resources</h3>
    <p>Summarized from primary materials: the firm's own pages and, where explicitly labeled, official portfolio-company announcements or regulated disclosures. Checked on the date above. Mandates and programs may change; this is not a live availability or investment-performance assessment.</p>
    <ol>
      {profile.sources.map((source) => (
        <li id={`investor-source-${source.id}`}>
          <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>
          {source.source_type && source.source_type !== "official_firm" && (
            <span class="source-type">{
              source.source_type === "official_portfolio_company" ? "Official portfolio company"
                : source.source_type === "official_related_entity" ? "Official related entity"
                  : "Regulated disclosure"
            }</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .firm-profile { margin-bottom: var(--space-12); }
  .profile-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; }
  h2 { font-size: 1.1rem; margin: 0; }
  .review-date { font-size: .75rem; color: var(--color-text-secondary); margin: 0; }
  .profile-summary { max-width: 700px; font-size: 1rem; line-height: 1.7; margin: var(--space-4) 0 var(--space-6); }
  .profile-facts { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--space-8); margin: 0; }
  .profile-fact { padding: var(--space-4) 0; border-top: 1px solid var(--color-border); min-width: 0; }
  .wide { grid-column: 1 / -1; }
  dt { font-size: .7rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--color-text-secondary); margin-bottom: var(--space-2); }
  dd { margin: 0; font-size: .9rem; line-height: 1.65; overflow-wrap: anywhere; }
  .citations { display: inline-flex; gap: .25rem; font-size: .7rem; margin-left: .4rem; vertical-align: super; white-space: nowrap; }
  .citations a { padding: .2rem .1rem; }
  a { color: var(--color-editor-line); }
  .profile-sources { margin-top: var(--space-4); padding: var(--space-4) var(--space-5); border-left: 2px solid var(--color-border); background: var(--color-bg-card); }
  h3 { font-size: .8rem; margin: 0 0 var(--space-2); }
  .profile-sources p { font-size: .75rem; line-height: 1.6; color: var(--color-text-secondary); margin: 0 0 var(--space-2); max-width: 680px; }
  ol { margin: 0; padding-left: 1.25rem; font-size: .8rem; line-height: 1.8; }
  li { scroll-margin-top: 6rem; }
  .source-type { display: inline-block; margin-left: .45rem; color: var(--color-text-secondary); font-size: .68rem; }
  a:focus-visible { outline: 2px solid var(--color-editor-line); outline-offset: 3px; }
  @media (max-width: 600px) { .profile-facts { grid-template-columns: 1fr; } }
</style>
