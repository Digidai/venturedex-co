---
import "../styles/global.css";
import MicrosoftClarity from "../components/MicrosoftClarity.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  DEFAULT_SITE_URL,
  SITE_NAME,
  absoluteUrl,
  canonicalPath as normalizeCanonicalPath,
  toIsoDateTime,
  truncateText,
  type JsonLdNode,
} from "../lib/seo";
import { resolveSocialPreviewMeta } from "../lib/social-meta";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  canonicalPath?: string;
  agentResourcePath?: string;
  robots?: string;
  ogType?: string;
  publishedTime?: string | null;
  modifiedTime?: string | null;
  schema?: JsonLdNode | JsonLdNode[];
  analytics?: boolean;
  referrerPolicy?: "no-referrer";
}

const {
  title,
  description = "A curated gallery of startups worth watching.",
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  canonicalPath,
  agentResourcePath,
  robots = "index,follow,max-image-preview:large",
  ogType = "website",
  publishedTime,
  modifiedTime,
  schema,
  analytics = true,
  referrerPolicy,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? DEFAULT_SITE_URL;
const canonicalURL = absoluteUrl(normalizeCanonicalPath(canonicalPath ?? Astro.url.pathname), siteUrl);
const startupResourcePath = agentResourcePath ?? (/^\/startups\/[a-z0-9-]+$/.test(normalizeCanonicalPath(Astro.url.pathname))
  ? normalizeCanonicalPath(Astro.url.pathname)
  : null);
const metaDescription = truncateText(description);
const pageTitle = `${title} | ${SITE_NAME}`;
const social = resolveSocialPreviewMeta({
  title,
  siteUrl,
  image: ogImage,
  imageWidth: ogImageWidth,
  imageHeight: ogImageHeight,
  imageType: ogImageType,
  twitterSite: import.meta.env.PUBLIC_TWITTER_SITE,
});
const publishedIso = toIsoDateTime(publishedTime);
const modifiedIso = toIsoDateTime(modifiedTime);
const schemaItems = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// Escape "<" so values containing "</script>" cannot break out of the ld+json block.
const schemaJson = schemaItems.map((item) => JSON.stringify(item).split("<").join("\\u003c"));

// Cloudflare Web Analytics beacon — privacy-friendly, cookieless, deferred.
// Baked at build time (PUBLIC_ env is inlined), so it ships on prerendered and
// SSR pages alike. Renders nothing when unset (local dev / not configured), so
// it never beacons during development or before a token exists.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const currentSection = (path: string) => Astro.url.pathname === path || Astro.url.pathname.startsWith(`${path}/`) || (path === "/directory" && Astro.url.pathname.startsWith("/categories")) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/dm-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    {referrerPolicy && <meta name="referrer" content={referrerPolicy} />}
    <meta name="application-name" content={SITE_NAME} />
    <meta name="theme-color" content="#fafaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0e" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    {ogType === "article" && publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {ogType === "article" && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
    <meta property="og:image" content={social.imageUrl} />
    {social.imageSecureUrl && <meta property="og:image:secure_url" content={social.imageSecureUrl} />}
    {social.imageWidth && <meta property="og:image:width" content={String(social.imageWidth)} />}
    {social.imageHeight && <meta property="og:image:height" content={String(social.imageHeight)} />}
    {social.imageType && <meta property="og:image:type" content={social.imageType} />}
    <meta property="og:image:alt" content={social.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {social.twitterSite && <meta name="twitter:site" content={social.twitterSite} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={social.imageUrl} />
    <meta name="twitter:image:alt" content={social.imageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="VentureDex" href="/feed.xml" />
    <link rel="alternate" type="text/plain" title="VentureDex LLM navigation" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="VentureDex full LLM context" href="/llms-full.txt" />
    <link rel="alternate" type="application/json" title="VentureDex AI index" href="/ai-index.json" />
    <link rel="describedby" type="text/plain" title="Agent reading guide" href="/llms.txt" />
    <link rel="alternate" type="application/json" title="Compact startup index" href="/startup-index.json" />
    <link rel="alternate" type="application/json" title="Research change snapshot" href="/changes.json" />
    {startupResourcePath && <link rel="alternate" type="text/markdown" href={`${startupResourcePath}.md`} />}
    {startupResourcePath && <link rel="alternate" type="application/json" href={`${startupResourcePath}.json`} />}
    {schemaJson.map((json) => (
      <script is:inline type="application/ld+json" set:html={json} />
    ))}
    {analytics && <MicrosoftClarity />}
    <script is:inline>
      (function(){var t;try{t=localStorage.getItem('venturedex-theme')}catch{}if(t&&t!=='auto'){document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t}})();
    </script>
    {analytics && cfBeaconToken && (
      <script is:inline define:vars={{ token: cfBeaconToken }}>
        {/* Inject the CF Web Analytics beacon during idle time, after the page is
            interactive, so its ~700ms of script execution stays out of the TBT/LCP
            window (it was the top main-thread cost). Still records the pageview. */}
        (function () {
          var done = false;
          function load() {
            if (done) return;
            done = true;
            var s = document.createElement("script");
            s.defer = true;
            s.src = "https://static.cloudflareinsights.com/beacon.min.js";
            s.setAttribute("data-cf-beacon", JSON.stringify({ token: token }));
            document.head.appendChild(s);
          }
          if ("requestIdleCallback" in window) {
            requestIdleCallback(load, { timeout: 4000 });
          } else {
            addEventListener("load", function () { setTimeout(load, 1500); });
          }
        })();
      </script>
    )}
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to main content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="logo">VentureDex</a>
        <nav aria-label="Main navigation">
          <div class="nav-tabs">
            <a href="/directory" class="nav-tab" aria-current={currentSection("/directory")}>Directory</a>
            <a href="/collections" class="nav-tab" aria-current={currentSection("/collections")}>Collections</a>
            <a href="/topics" class="nav-tab" aria-current={currentSection("/topics")}>Topics</a>
            <a href="/weekly" class="nav-tab" aria-current={currentSection("/weekly")}>Weekly</a>
            <a href="/launches" class="nav-tab" aria-current={currentSection("/launches")}>Launches</a>
            <a href="/investors" class="nav-tab" aria-current={currentSection("/investors")}>Investors</a>
            <a href="/news" class="nav-tab" aria-current={currentSection("/news")}>News</a>
          </div>
        </nav>
        <div class="header-actions">
          <details class="mobile-menu">
            <summary>Menu</summary>
            <nav class="nav-dropdown" aria-label="Mobile navigation">
              <a href="/directory">Directory</a>
              <a href="/categories">Browse categories</a>
              <a href="/investors">Investors</a>
              <a href="/news">Funding news</a>
              <a href="/topics">Research topics</a>
              <a href="/collections">Collections</a>
              <a href="/weekly">Weekly digest</a>
              <a href="/launches">Product launches</a>
              <a href="/research">Research methodology</a>
              <a href="/search">Search all research</a>
            </nav>
          </details>
          <a href="/search" class="header-search" aria-label="Search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
          <ThemeToggle />
          <a href="/subscribe" class="header-cta">Subscribe</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <script>
      const menus = document.querySelectorAll<HTMLDetailsElement>(".mobile-menu");
      for (const menu of menus) {
        menu.addEventListener("keydown", (event) => {
          if (event.key !== "Escape") return;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        });
        document.addEventListener("focusin", (event) => {
          if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
        document.addEventListener("click", (event) => {
          if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
        });
      }
    </script>

    <style>
      .site-header {
        border-bottom: 1px solid var(--color-border);
        padding: var(--space-4) 0;
      }

      .header-inner {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: var(--space-4);
      }

      .logo {
        font-family: var(--font-heading);
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-text);
        text-decoration: none;
        flex: 0 0 auto;
        justify-self: start;
      }

      .header-inner > nav {
        min-width: 0;
        justify-self: center;
        max-width: 100%;
      }

      .nav-tabs {
        display: flex;
        gap: 0;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        overflow: visible;
      }
      .mobile-menu { position: static; }
      .mobile-menu { display: none; }
      .mobile-menu > summary { cursor: pointer; white-space: nowrap; font-size: .8rem; padding: 10px 8px; color: var(--color-text); }
      .nav-dropdown { position: absolute; right: var(--space-4); top: calc(100% + 10px); z-index: 30; min-width: 220px; max-width: calc(100vw - 32px); max-height: calc(100dvh - 96px); overflow-y: auto; padding: var(--space-2); background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius); box-shadow: 0 12px 30px rgb(0 0 0 / .09); }
      .nav-dropdown a { display: block; padding: 12px; color: var(--color-text); font-size: .85rem; text-decoration: none; border-radius: var(--radius); }
      .nav-dropdown a:hover, .nav-dropdown a:focus-visible { background: var(--color-badge-bg); }

      .nav-tab {
        padding: var(--space-2) var(--space-4);
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
        border-right: 1px solid var(--color-border);
      }

      .nav-tab:last-child {
        border-right: none;
      }

      .nav-tab:hover, .nav-tab[aria-current="page"] {
        background: var(--color-badge-bg);
        color: var(--color-text);
        text-decoration: none;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        flex: 0 0 auto;
        justify-self: end;
      }

      .header-search {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        color: var(--color-text-secondary);
        transition: color 0.15s, background 0.15s;
      }

      .header-search:hover {
        color: var(--color-text);
        background: var(--color-badge-bg);
      }

      .header-cta {
        font-size: 0.8rem;
        font-weight: 600;
        padding: var(--space-2) var(--space-4);
        background: var(--color-text);
        color: var(--color-bg);
        border-radius: 6px;
        text-decoration: none;
        transition: opacity 0.15s;
      }

      .header-cta:hover {
        opacity: 0.85;
        text-decoration: none;
      }

      @media (max-width: 1000px) {
        .header-inner {
          grid-template-columns: 1fr auto;
          gap: var(--space-3);
          align-items: center;
        }

        .header-inner > nav {
          display: none;
        }
        .mobile-menu { display: block; }
        .header-search { display: none; }

        .header-inner > nav::-webkit-scrollbar {
          display: none;
        }

        .nav-tabs {
          display: inline-flex;
          flex: 0 0 auto;
          width: max-content;
          max-width: 100%;
        }

        .nav-tab {
          flex: 0 0 auto;
          text-align: center;
          font-size: 0.75rem;
          padding: var(--space-2) var(--space-3);
        }

        .header-cta {
          font-size: 0.75rem;
        }
      }

      @media (max-width: 420px) {
        .header-inner {
          align-items: center;
          gap: var(--space-2);
        }

        .header-inner > nav {
          justify-content: flex-start;
        }

        .nav-tabs {
          max-width: none;
        }

        .nav-tab {
          padding-inline: var(--space-2);
        }

        .header-actions {
          gap: var(--space-1);
        }

        .header-cta {
          padding-inline: var(--space-3);
        }
      }
      @media (max-width: 360px) {
        .header-inner { padding-inline: var(--space-4); gap: var(--space-1); }
        .logo { font-size: 1.125rem; }
        .mobile-menu > summary { padding-inline: var(--space-1); }
        .header-cta { padding-inline: 10px; }
      }
    </style>
  </body>
</html>
