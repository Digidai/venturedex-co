---
export const prerender = true;
import FundingNewsPage from "../../../components/FundingNewsPage.astro";
import { getContentNewsEligibleFundingRounds } from "../../../lib/content";
import { paginateFundingRounds } from "../../../lib/funding-pagination";

export function getStaticPaths() {
  const { totalPages } = paginateFundingRounds(getContentNewsEligibleFundingRounds());
  return Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2 },
  }));
}
const { page } = Astro.props;
---
<FundingNewsPage page={page} />
