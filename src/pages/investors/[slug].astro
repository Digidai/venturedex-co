---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import BrandLogo from "../../components/BrandLogo.astro";
import InvestorProfile from "../../components/InvestorProfile.astro";
import SiteCard from "../../components/SiteCard.astro";
import { getInvestorActivity } from "../../lib/investor-activity-content";
import { INVESTOR_ROLE_LABELS } from "../../lib/investor-participation";
import {
  getCompanyBrandAsset,
  getInvestorBrandAsset,
} from "../../lib/brand-assets";
import { getContentInvestorBySlug, getContentInvestors, getContentStartupBySlug } from "../../lib/content";
import { evaluateInvestorIndexEligibility } from "../../lib/investor-indexing";
import { getInvestorProfile } from "../../lib/investor-profile-content";
import { fundingAmountLabel, fundingStageLabel } from "../../lib/funding-terms";
import { expandSeoDescription, investorJsonLd, normalizeExternalUrl } from "../../lib/seo";

export function getStaticPaths() {
  return getContentInvestors().map((investor) => ({ params: { slug: investor.slug } }));
}

const { slug } = Astro.params;
const { investor } = getContentInvestorBySlug(slug!)!;
const rounds = getInvestorActivity().get(investor.slug) ?? [];
const companies = [...new Set(rounds.map(round => round.company_slug))]
  .flatMap(slug => { const company = slug ? getContentStartupBySlug(slug) : null; return company ? [company] : []; });
const eligibility = evaluateInvestorIndexEligibility(rounds);
const profile = getInvestorProfile(investor.slug);
const roundDates = rounds.map((round) => round.date).filter(Boolean).sort();
const trackedStages = [...new Set(rounds.map((round) => round.stage))];
const investorBrand = getInvestorBrandAsset(investor.slug);
const description = expandSeoDescription(
  profile?.summary.value ?? investor.description,
  "Browse VentureDex-tracked startup funding activity, portfolio companies, and source-backed company context.",
  `${investor.name} portfolio on VentureDex.`
);
const schema = investorJsonLd({ ...investor, description: profile?.summary.value ?? investor.description }, rounds, Astro.site?.toString());
const investorWebsiteUrl = normalizeExternalUrl(investor.website);
const investorWebsiteHost = investorWebsiteUrl ? displayHostname(investorWebsiteUrl) : null;
// Keep the full <title> (Base appends " | VentureDex", 13 chars) under ~60 for Google.
const TITLE_MAX = 46;
const fullInvestorTitle = `${investor.name} Startup Investment Portfolio`;
const shortInvestorTitle = `${investor.name} Startup Portfolio`;
const pageTitle = fullInvestorTitle.length <= TITLE_MAX
  ? fullInvestorTitle
  : shortInvestorTitle.length <= TITLE_MAX
    ? shortInvestorTitle
    : investor.name;

function displayHostname(value: string): string {
  try {
    return new URL(value).hostname.replace(/^www\./, "");
  } catch {
    return value;
  }
}
---

<Base
  title={pageTitle}
  description={description}
  robots={eligibility.indexable ? undefined : "noindex,follow"}
  schema={schema}
>
  <div class="container investor-page">
    <a href="/investors" class="back-link">&larr; All investors</a>

    <header class="investor-header">
      <div class="investor-identity">
        <BrandLogo asset={investorBrand} name={investor.name} size={40} class="investor-logo" loading="eager" />
        <div>
          <h1>{investor.name}</h1>
          {investorWebsiteUrl && investorWebsiteHost && (
            <a href={investorWebsiteUrl} target="_blank" rel="noopener noreferrer" class="investor-url">
              {investorWebsiteHost} ↗
            </a>
          )}
        </div>
      </div>
      {!profile && investor.description && <p class="investor-desc">{investor.description}</p>}
    </header>

    {profile && <InvestorProfile profile={profile} />}

    <section class="portfolio">
      <h2>Tracked funding activity</h2>
      <p class="coverage-note">A partial view of source-linked funding rounds. Roles distinguish reported leads, confirmed participants, and investments with no lead role stated. Historical aliases may appear. Not the firm's complete portfolio. Amounts are company round totals, not this investor's contribution.</p>
      {rounds.length > 0 && (
        <dl class="activity-stats">
          <div><dt>Companies</dt><dd>{eligibility.distinctCompanyCount}</dd></div>
          <div><dt>Funding rounds</dt><dd>{rounds.length}</dd></div>
          <div><dt>Latest tracked round</dt><dd class="stat-date"><time datetime={roundDates.at(-1)}>{roundDates.at(-1)}</time></dd></div>
        </dl>
        <p class="tracked-stages">Stages in this dataset: {trackedStages.join(" · ")}. These do not define the firm's mandate.</p>
      )}

      {rounds.length > 0 ? (
        <div class="portfolio-table-wrap">
          <table class="portfolio-table">
            <thead>
              <tr>
                <th>Company</th>
                <th>Company round</th>
                <th>Date</th>
                <th>Investor role</th>
                <th>Source</th>
              </tr>
            </thead>
            <tbody>
              {rounds.map((r) => {
                const companyBrand = getCompanyBrandAsset(r.company_slug);
                return (
                  <tr>
                    <td class="cell-company">
                      <div class="company-info">
                        <BrandLogo asset={companyBrand} name={r.company_name} size={24} class="company-logo" />
                        <div>
                          {r.company_slug ? (
                            <a href={`/startups/${r.company_slug}`} class="company-link">{r.company_name}</a>
                          ) : (
                            <span>{r.company_name}</span>
                          )}
                        </div>
                      </div>
                    </td>
                    <td class="cell-round">
                      <span class="round-amount">{fundingAmountLabel(r)}</span>
                      <span class="round-stage">· {fundingStageLabel(r)}</span>
                    </td>
                    <td class="cell-date">
                      {new Date(r.date + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
                    </td>
                    <td class="cell-source">
                      {INVESTOR_ROLE_LABELS[r.investor_role]}
                    </td>
                    <td class="cell-source">
                      <a href={r.source_url!} target="_blank" rel="noopener noreferrer" class="source-link">
                        {r.source_name || "Press"} ↗
                      </a>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty">No source-linked funding activity tracked yet. This does not mean the firm has no investments.</p>
      )}
    </section>
    {companies.length > 0 && (
      <section class="portfolio-companies" aria-labelledby="companies-heading">
        <h2 id="companies-heading">Explore tracked companies</h2>
        <p class="coverage-note">Companies covered by VentureDex, not a complete portfolio or investment recommendation.</p>
        <div class="portfolio-grid">{companies.map(company => <SiteCard startup={company} />)}</div>
      </section>
    )}
  </div>
</Base>

<style>
  .portfolio-companies { margin-top: var(--space-8); }
  .portfolio-companies h2 { font-size: 1.1rem; margin-bottom: var(--space-3); }
  .portfolio-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  @media (max-width: 640px) { .portfolio-grid { grid-template-columns: minmax(0, 1fr); } }
  .investor-page {
    max-width: 900px;
    padding: var(--space-12) var(--space-6) var(--space-16);
  }

  .back-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    display: inline-block;
    margin-bottom: var(--space-6);
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .investor-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .investor-identity {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .investor-header h1 {
    font-size: 1.75rem;
    margin-bottom: var(--space-1);
  }

  .investor-url {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .investor-url:hover {
    color: var(--color-editor-line);
  }

  .investor-desc {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 600px;
  }

  .portfolio h2 {
    font-size: 1.1rem;
    margin-bottom: var(--space-3);
  }

  .coverage-note, .tracked-stages {
    color: var(--color-text-secondary);
    font-size: .8rem;
    line-height: 1.65;
    margin-bottom: var(--space-5);
  }
  .activity-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: var(--space-4);
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-5);
    margin: 0 0 var(--space-4);
  }
  .activity-stats dt { font-size: .7rem; color: var(--color-text-secondary); margin-bottom: var(--space-2); }
  .activity-stats dd { margin: 0; font-size: 1.4rem; font-weight: 600; }
  .activity-stats .stat-date { font-size: 1rem; padding-top: .25rem; }
  @media (max-width: 420px) {
    .activity-stats { grid-template-columns: 1fr 1fr; }
    .activity-stats > div:last-child { grid-column: 1 / -1; }
  }

  .count {
    font-weight: 400;
    color: var(--color-text-secondary);
  }

  .portfolio-table-wrap {
    overflow-x: auto;
  }

  .portfolio-table {
    width: 100%;
    border-collapse: collapse;
  }

  .portfolio-table thead th {
    text-align: left;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .portfolio-table tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: background 0.1s;
  }

  .portfolio-table tbody tr:hover {
    background: var(--color-badge-bg);
  }

  .portfolio-table td {
    padding: var(--space-4);
    font-size: 0.85rem;
    vertical-align: middle;
  }

  .cell-company {
    font-weight: 600;
  }

  .company-info {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .company-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .company-link:hover {
    color: var(--color-editor-line);
  }

  .round-amount {
    color: var(--color-editor-line);
    font-weight: 600;
  }

  .round-stage {
    color: var(--color-text-secondary);
  }

  .cell-date {
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .source-link {
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .source-link:hover {
    color: var(--color-editor-line);
  }

  .empty {
    color: var(--color-text-secondary);
    padding: var(--space-8) 0;
  }
</style>
