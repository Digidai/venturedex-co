---
export const prerender = true;

import Base from "../layouts/Base.astro";
import LaunchCard from "../components/LaunchCard.astro";
import {
  getWhatShipsCategoryCounts,
  whatShipsSnapshot,
} from "../lib/whatships";

const INITIAL_PAGE_SIZE = 24;
const initialItems = whatShipsSnapshot.items.slice(0, INITIAL_PAGE_SIZE);
const categories = getWhatShipsCategoryCounts();
const latestDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(whatShipsSnapshot.source_published_through));
const countLabel = new Intl.NumberFormat("en").format(whatShipsSnapshot.item_count);
const description = `Browse ${countLabel} product launch videos, demos, and walkthroughs on VentureDex, each organized around its original video evidence.`;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Product Launches",
  description,
  url: "https://venturedex.co/launches",
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: whatShipsSnapshot.item_count,
    itemListElement: initialItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      url: `https://venturedex.co/launches/${item.slug}`,
    })),
  },
};
---

<Base
  title="Product Launches"
  description={description}
  canonicalPath="/launches"
  modifiedTime={whatShipsSnapshot.source.commit_at}
  schema={schema}
  referrerPolicy="no-referrer"
>
  <div class="launches-page" data-launches-root>
    <section class="launch-directory" aria-labelledby="launch-directory-title" data-launch-directory>
      <div class="container">
        <header class="launch-directory__intro">
          <div class="launch-directory__copy">
            <p class="section-label">VentureDex launch channel</p>
            <h1>Product launch videos</h1>
            <p>
              Demos and walkthroughs, organized as durable VentureDex pages with the original video and post.
            </p>
          </div>
          <dl class="launch-directory__stats">
            <div><dt>Videos</dt><dd>{countLabel}</dd></div>
            <div><dt>Latest post</dt><dd>{latestDate}</dd></div>
          </dl>
        </header>

        <div class="launch-directory__heading">
          <div>
            <p class="section-label">Video index</p>
            <h2 id="launch-directory-title">Latest launches</h2>
          </div>
          <p class="launch-results" data-launch-results aria-live="polite">
            Latest {initialItems.length} of {countLabel} entries
          </p>
        </div>

        <form class="launch-controls" data-launch-controls>
          <label class="launch-search">
            <span>Search launches</span>
            <input type="search" name="q" placeholder="Product, company, title, or tag" autocomplete="off" data-launch-search />
          </label>
          <label class="launch-category">
            <span>Category</span>
            <select name="category" data-launch-category>
              <option value="">All categories</option>
              {categories.map((category) => (
                <option value={category.id}>{category.label} ({category.count})</option>
              ))}
            </select>
          </label>
        </form>

        <div class="launch-grid" data-launch-grid>
          {initialItems.map((item, index) => <LaunchCard item={item} eager={index < 6} />)}
        </div>

        <div class="launch-empty" data-launch-empty hidden>
          <h2>No matching launches.</h2>
          <p>Try a broader search or another category.</p>
        </div>

        <nav class="launch-pagination" aria-label="Launch index pages" data-launch-pagination hidden>
          <button type="button" data-launch-prev>Previous</button>
          <span data-launch-page>Page 1</span>
          <button type="button" data-launch-next>Next</button>
        </nav>

        <noscript>
          <p class="launch-noscript">
            JavaScript is off, so this page shows the latest {initialItems.length} VentureDex launch pages.
          </p>
        </noscript>
      </div>
    </section>
  </div>
</Base>

<script>
  type LaunchItem = {
    id: string;
    tweet_id: string;
    slug: string;
    title: string;
    product: string;
    company: string;
    category: string;
    tags: string[];
    published_at: string;
    duration_seconds: number | null;
    video_url: string;
    original_post_url: string;
  };

  type LaunchPayload = {
    item_count: number;
    items: LaunchItem[];
  };

  const PAGE_SIZE = 24;
  // @cloudflare/workers-types is global and its DOM-lite declarations shadow
  // lib.dom inside Astro client scripts. Use the same narrow adapter pattern as
  // the homepage filter script so runtime values remain ordinary DOM elements.
  const query = <T,>(selector: string, scope: any = document): T | null =>
    scope ? ((scope.querySelector(selector) as T) ?? null) : null;
  const root = query<any>("[data-launches-root]");
  const directory = query<any>("[data-launch-directory]", root);
  const grid = query<any>("[data-launch-grid]", root);
  const search = query<any>("[data-launch-search]", root);
  const category = query<any>("[data-launch-category]", root);
  const results = query<any>("[data-launch-results]", root);
  const empty = query<any>("[data-launch-empty]", root);
  const pagination = query<any>("[data-launch-pagination]", root);
  const previous = query<any>("[data-launch-prev]", root);
  const next = query<any>("[data-launch-next]", root);
  const pageLabel = query<any>("[data-launch-page]", root);
  let items: LaunchItem[] = [];
  let currentPage = 1;

  const categoryLabels: Record<string, string> = {
    ai: "AI",
    consumer: "Consumer",
    design: "Design",
    "developer-tools": "Developer tools",
    hardware: "Hardware",
    motion: "Motion",
    other: "Other",
    productivity: "Productivity",
  };

  function appendText<K extends keyof HTMLElementTagNameMap>(
    parent: any,
    tag: K,
    className: string,
    value: string,
  ): any {
    const element = document.createElement(tag) as any;
    element.className = className;
    element.textContent = value;
    parent.appendChild(element);
    return element;
  }

  const detailPath = (item: LaunchItem): string => `/launches/${item.slug}`;

  function formatDuration(seconds: number | null): string {
    if (!seconds) return "Duration unavailable";
    const hours = Math.floor(seconds / 3600);
    const minutes = Math.floor((seconds % 3600) / 60);
    const remainder = seconds % 60;
    return hours > 0
      ? `${hours}:${String(minutes).padStart(2, "0")}:${String(remainder).padStart(2, "0")}`
      : `${minutes}:${String(remainder).padStart(2, "0")}`;
  }

  function renderCard(item: LaunchItem): any {
    const card = document.createElement("article") as any;
    card.className = "launch-card";

    const cardLink = document.createElement("a") as any;
    cardLink.className = "launch-card__link";
    cardLink.href = detailPath(item);
    cardLink.setAttribute("aria-label", `View VentureDex launch page for ${item.title}`);

    const media = document.createElement("div") as any;
    media.className = "launch-card__media";
    media.dataset.launchMedia = "";
    appendText(media, "span", "launch-card__preview-fallback", item.product.slice(0, 1))
      .setAttribute("aria-hidden", "true");
    const preview = document.createElement("video") as any;
    preview.className = "launch-card__preview";
    preview.dataset.videoSrc = item.video_url;
    preview.dataset.launchPreview = "";
    preview.preload = "none";
    preview.muted = true;
    preview.playsInline = true;
    preview.setAttribute("aria-hidden", "true");
    media.appendChild(preview);
    const play = appendText(media, "span", "launch-card__play", "▶");
    play.setAttribute("aria-hidden", "true");
    if (item.duration_seconds) {
      appendText(media, "span", "launch-card__duration", formatDuration(item.duration_seconds));
    }
    cardLink.appendChild(media);

    const content = document.createElement("div") as any;
    content.className = "launch-card__content";

    const meta = document.createElement("div");
    meta.className = "launch-card__meta";
    appendText(meta, "span", "launch-card__category", categoryLabels[item.category] ?? item.category);
    const time = document.createElement("time");
    time.dateTime = item.published_at;
    time.textContent = new Intl.DateTimeFormat("en", {
      month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
    }).format(new Date(item.published_at));
    meta.appendChild(time);
    content.appendChild(meta);

    const heading = document.createElement("h2");
    heading.textContent = item.title;
    content.appendChild(heading);

    const identity = document.createElement("p");
    identity.className = "launch-card__identity";
    appendText(identity, "strong", "", item.product);
    if (item.company !== item.product) appendText(identity, "span", "", `by ${item.company}`);
    content.appendChild(identity);

    if (item.tags.length > 0) {
      const tags = document.createElement("ul");
      tags.className = "launch-card__tags";
      tags.setAttribute("aria-label", "Tags");
      for (const tag of item.tags.slice(0, 3)) appendText(tags, "li", "", tag);
      content.appendChild(tags);
    }

    const footer = document.createElement("div");
    footer.className = "launch-card__footer";
    footer.setAttribute("aria-hidden", "true");
    appendText(footer, "span", "launch-card__detail-link", "View launch");
    appendText(footer, "span", "launch-card__arrow", "→");
    content.appendChild(footer);
    cardLink.appendChild(content);
    card.appendChild(cardLink);
    return card;
  }

  const previewObserver = typeof IntersectionObserver === "undefined"
    ? null
    : new IntersectionObserver((entries: any[]) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          loadPreview(entry.target);
          previewObserver?.unobserve(entry.target);
        }
      }, { rootMargin: "240px 0px" });

  function loadPreview(preview: any): void {
    if (preview.src) return;
    const source = preview.dataset.videoSrc;
    if (!source) return;
    preview.preload = "metadata";
    preview.src = source;
    preview.load();
  }

  function bindPreviews(scope: any): void {
    for (const preview of scope?.querySelectorAll?.("[data-launch-preview]") ?? []) {
      if (preview.dataset.previewBound === "true") continue;
      preview.dataset.previewBound = "true";
      const media = preview.closest("[data-launch-media]");
      const markReady = () => media?.classList.add("is-ready");
      const markUnavailable = () => media?.classList.add("is-unavailable");
      preview.addEventListener("loadeddata", markReady, { once: true });
      preview.addEventListener("error", markUnavailable, { once: true });
      if (preview.readyState >= 2) markReady();
      if (preview.src) preview.load();
      else if (previewObserver) previewObserver.observe(preview);
      else loadPreview(preview);
    }
  }

  function normalizedQuery(): string[] {
    return (search?.value ?? "").trim().toLowerCase().split(/\s+/).filter(Boolean);
  }

  function updateUrl(): void {
    const params = new URLSearchParams();
    const query = (search?.value ?? "").trim();
    const selectedCategory = category?.value ?? "";
    if (query) params.set("q", query);
    if (selectedCategory) params.set("category", selectedCategory);
    if (currentPage > 1) params.set("page", String(currentPage));
    history.replaceState(null, "", `${location.pathname}${params.size ? `?${params}` : ""}`);
  }

  function apply(): void {
    if (!grid) return;
    const query = normalizedQuery();
    const selectedCategory = category?.value ?? "";
    const filtered = items.filter((item) => {
      if (selectedCategory && item.category !== selectedCategory) return false;
      if (query.length === 0) return true;
      const text = [item.title, item.product, item.company, ...item.tags].join(" ").toLowerCase();
      return query.every((term) => text.includes(term));
    });
    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    currentPage = Math.min(Math.max(1, currentPage), totalPages);
    const start = (currentPage - 1) * PAGE_SIZE;
    const visible = filtered.slice(start, start + PAGE_SIZE);
    grid.replaceChildren(...visible.map(renderCard));
    bindPreviews(grid);
    if (empty) empty.hidden = visible.length > 0;
    if (results) {
      const formatted = new Intl.NumberFormat("en").format(filtered.length);
      results.textContent = `${formatted} matching ${filtered.length === 1 ? "entry" : "entries"}`;
    }
    if (pagination) pagination.hidden = filtered.length <= PAGE_SIZE;
    if (previous) previous.disabled = currentPage <= 1;
    if (next) next.disabled = currentPage >= totalPages;
    if (pageLabel) pageLabel.textContent = `Page ${currentPage} of ${totalPages}`;
    updateUrl();
  }

  function restoreState(): void {
    const params = new URLSearchParams(location.search);
    if (search) search.value = params.get("q") ?? "";
    if (category) {
      const requested = params.get("category") ?? "";
      category.value = [...category.options].some((option) => option.value === requested) ? requested : "";
    }
    const requestedPage = Number(params.get("page") ?? "1");
    currentPage = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
  }

  if (root && grid) {
    bindPreviews(root);
    restoreState();
    fetch("/launches.json", { headers: { Accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json() as Promise<LaunchPayload>;
      })
      .then((payload) => {
        if (!Array.isArray(payload.items) || payload.item_count !== payload.items.length) {
          throw new Error("Invalid launch index payload");
        }
        items = payload.items;
        apply();
      })
      .catch(() => {
        if (results) results.textContent = "Showing the latest cached entries; full index unavailable.";
      });

    let timer = 0;
    search?.addEventListener("input", () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { currentPage = 1; apply(); }, 120);
    });
    category?.addEventListener("change", () => { currentPage = 1; apply(); });
    previous?.addEventListener("click", () => { currentPage -= 1; apply(); directory?.scrollIntoView({ behavior: "smooth" }); });
    next?.addEventListener("click", () => { currentPage += 1; apply(); directory?.scrollIntoView({ behavior: "smooth" }); });
  }
</script>

<style is:global>
  .launches-page {
    --launch-ink: var(--color-text);
    --launch-muted: var(--color-text-secondary);
  }

  .launch-directory {
    padding-block: clamp(1.75rem, 3vw, 2.75rem) clamp(3.5rem, 7vw, 6rem);
    background:
      radial-gradient(circle at 88% 0%, color-mix(in srgb, var(--color-text) 4%, transparent), transparent 26rem),
      var(--color-bg);
  }

  .section-label {
    margin: 0 0 0.4rem;
    color: var(--launch-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .launch-directory__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.36fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    padding-bottom: clamp(1.4rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--color-border);
  }
  .launch-directory__intro h1 {
    margin: 0;
    font-size: clamp(2.35rem, 3.8vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .launch-directory__copy > p:last-child {
    max-width: 46rem;
    margin: 0.65rem 0 0;
    color: var(--launch-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .launch-directory__stats {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .launch-directory__stats div {
    min-width: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .launch-directory__stats div + div { padding-left: var(--space-4); }
  .launch-directory__stats dt {
    margin-bottom: 0.2rem;
    color: var(--launch-muted);
    font-size: 0.68rem;
  }
  .launch-directory__stats dd {
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .launch-directory__heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    align-items: end;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0.8rem;
  }
  .launch-directory__heading h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    line-height: 1.05;
  }
  .launch-results { margin: 0; color: var(--launch-muted); font-family: var(--font-mono); font-size: 0.7rem; }

  .launch-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.32fr);
    gap: var(--space-3);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-card-bg);
  }
  .launch-controls label { position: relative; display: block; }
  .launch-controls label > span {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .launch-controls input,
  .launch-controls select {
    width: 100%;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .launch-controls input:focus,
  .launch-controls select:focus { outline: 2px solid var(--color-text); outline-offset: 2px; }

  .launch-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.8rem, 1.5vw, 1.25rem);
    align-items: stretch;
  }
  .launch-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 13px;
    background: var(--color-bg);
    box-shadow: 0 1px 0 rgb(0 0 0 / 3%);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .launch-card:hover {
    border-color: color-mix(in srgb, var(--launch-ink) 32%, var(--color-border));
    box-shadow: 0 14px 30px rgb(0 0 0 / 8%);
    transform: translateY(-3px);
  }
  .launch-card__link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .launch-card__link:hover { text-decoration: none; }
  .launch-card__link:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--launch-ink);
  }
  .launch-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-badge-bg) 82%, var(--color-bg)), var(--color-bg));
    color: var(--color-text);
    isolation: isolate;
  }
  .launch-card__preview-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--launch-muted) 32%, transparent);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 700;
    text-transform: uppercase;
  }
  .launch-card__preview {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    object-fit: cover;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.35s ease, filter 0.35s ease;
  }
  .launch-card__media.is-ready .launch-card__preview { opacity: 1; }
  .launch-card:hover .launch-card__preview { transform: scale(1.03); filter: saturate(1.06); }
  .launch-card__media.is-unavailable .launch-card__preview { display: none; }
  .launch-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 38%);
    border-radius: 999px;
    background: rgb(10 10 10 / 70%);
    color: white;
    font-size: 0.85rem;
    line-height: 1;
    transform: translate(-50%, -50%);
    backdrop-filter: blur(5px);
    transition: transform 0.18s ease, background 0.18s ease;
  }
  .launch-card__play svg { margin-left: 0.12rem; }
  .launch-card:hover .launch-card__play {
    background: rgb(10 10 10 / 84%);
    transform: translate(-50%, -50%) scale(1.08);
  }
  .launch-card__duration {
    position: absolute;
    right: 0.65rem;
    bottom: 0.65rem;
    z-index: 2;
    padding: 0.24rem 0.38rem;
    border-radius: 3px;
    background: rgb(10 10 10 / 82%);
    color: white;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    line-height: 1;
  }
  .launch-card__content {
    display: flex;
    flex: 1;
    min-height: 12rem;
    flex-direction: column;
    padding: 0.95rem 1rem 0.9rem;
  }
  .launch-card__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--launch-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }
  .launch-card__category { color: var(--launch-ink); font-weight: 600; }
  .launch-card h2,
  .launch-card h3 {
    display: -webkit-box;
    min-height: 2.4em;
    margin: 0.75rem 0 0.55rem;
    overflow: hidden;
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .launch-card__identity {
    display: flex;
    min-width: 0;
    gap: 0.3rem;
    margin: 0;
    overflow: hidden;
    color: var(--launch-muted);
    font-size: 0.77rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .launch-card__identity strong { color: var(--launch-ink); font-weight: 600; }
  .launch-card__tags {
    display: flex;
    min-height: 1.45rem;
    gap: 0.3rem;
    margin: 0.8rem 0 0;
    overflow: hidden;
    padding: 0;
    list-style: none;
  }
  .launch-card__tags li {
    min-width: 0;
    max-width: 8rem;
    padding: 0.2rem 0.38rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--launch-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .launch-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.85rem;
  }
  .launch-card__detail-link {
    color: var(--launch-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .launch-card__arrow {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--launch-ink);
    font-size: 0.78rem;
